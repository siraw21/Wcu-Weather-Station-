PORT=3000
DB_PATH=./data/weather.db
LOG_PATH=./data/weather.log
RETENTION_DAYS=30

# Free-tier LLM API keys (keep strictly on backend; never expose to clients)
GEMINI_API_KEY="key"
OPENROUTER_API_KEY="key"

# Provider selection: gemini | openrouter
LLM_PRIMARY=gemini
LLM_FALLBACK=openrouter

# Optional model overrides (free-tier defaults)
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
